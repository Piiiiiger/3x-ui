[Unit]
Description=Pigger agent (Xray for a Pigger panel node)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=XUI_LOG_FOLDER=/var/log/pigger-agent
ExecStart=/usr/local/pigger-agent/pigger-agent -config /etc/pigger-agent/config.json
Restart=always
RestartSec=3s
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
