#!/sbin/openrc-run

name="pigger-agent"
description="Pigger agent (Xray for a Pigger panel node)"
command="/usr/local/pigger-agent/pigger-agent"
command_args="-config /etc/pigger-agent/config.json"
supervisor="supervise-daemon"
respawn_delay=3
respawn_max=0
output_log="/var/log/pigger-agent/console.log"
error_log="/var/log/pigger-agent/console.log"
export XUI_LOG_FOLDER="/var/log/pigger-agent"

depend() {
	need net
}

start_pre() {
	checkpath -d -m 0750 /var/log/pigger-agent
}
